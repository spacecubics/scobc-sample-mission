# Mission definitions for the SC-OBC Module V1 cFS mission
#
# See cfe/cmake/sample_defs/targets.cmake for the description of each
# variable.

set(MISSION_NAME "SCOBC")
set(SPACECRAFT_ID 0x42)

list(APPEND MISSION_GLOBAL_APPLIST sample_app sample_lib)

# Only the APU is a CPU of the cFE mission build, so the mission build
# makes one executable. The RPU is built with west by the cFE Zephyr
# module, which reads its rpu_ variables from this file.
set(MISSION_CPUNAMES apu)

# The APU runs Linux. The "yocto" toolchain (toolchain-yocto.cmake) is
# generated by the Yocto recipe from the toolchain of the build.
set(apu_PROCESSORID 1)
# The ground link runs on the RPU. ci_lab and to_lab on the APU are a direct
# link for development, until the link between the CPUs carries the APU's
# messages to the RPU.
set(apu_APPLIST ci_lab to_lab sch_lab)
set(apu_FILELIST cfe_es_startup.scr)
set(apu_SYSTEM yocto)

# The RPU runs Zephyr (CONFIG_CFS_CFE_CPU_NAME="rpu") and the ground link to
# Yamcs (ci_lab, to_lab over UDP). Its applications are linked into the
# image.
set(rpu_PROCESSORID 2)
set(rpu_APPLIST ci_lab to_lab sch_lab)
