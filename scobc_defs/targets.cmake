# Mission definitions for the SC-OBC Module V1 cFS mission
#
# See cfe/cmake/sample_defs/targets.cmake for the description of each
# variable.

set(MISSION_NAME "SCOBC")
set(SPACECRAFT_ID 0x42)

list(APPEND MISSION_GLOBAL_APPLIST sample_app sample_lib)

# The APU runs Linux. The "yocto" toolchain (toolchain-yocto.cmake) is
# generated by the Yocto recipe from the toolchain of the build.
set(MISSION_CPUNAMES apu)

set(apu_PROCESSORID 1)
set(apu_APPLIST ci_lab to_lab sch_lab)
set(apu_FILELIST cfe_es_startup.scr)
set(apu_SYSTEM yocto)
